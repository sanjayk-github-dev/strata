# Copy to .env.local for local development; set the same keys in the Vercel dashboard
# for deployment. .env.local is gitignored.

# --- Access gate -------------------------------------------------------------
# Unset locally: the app is open. Set in deployment: visitors must enter this
# passphrase once. Not authentication — a doorlock, so a public URL cannot spend
# your model credits. See /api/health to confirm it is armed.
# SITE_PASSCODE=

# --- Model provider ----------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Unset: the deterministic tiers
# still run and the app says the model tier was skipped.

LLM_API_KEY=

# OpenAI (default if unset)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Together
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# Ollama (local; any non-empty key)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# --- Storage -----------------------------------------------------------------
# Where cached source XML and model responses are written. Defaults to data/cache
# locally, and to the system temp directory where that is read-only (serverless).
# STRATA_CACHE_DIR=
